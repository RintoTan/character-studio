{
  "name": "character-studio",
  "private": true,
  "version": "2.30.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/character-studio/ && node scripts/build-info.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify:deploy": "node scripts/verify-deploy.mjs",
  "verify:version": "node scripts/verify-version.mjs",
  "verify:browser": "node scripts/verify-browser.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "vitest": "^3.2.7"
  }
}
